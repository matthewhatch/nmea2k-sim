NMEA_CAN_CHANNEL=vcan0
NMEA_SOURCE_ADDRESS=35
NMEA_RAPID_HZ=5
NMEA_DYNAMIC_HZ=1
# Unassigned, vcan-only test identity; never valid for physical transmission.
NMEA_MANUFACTURER_CODE=2046
NMEA_DEVICE_KEY=engine-0
# Set a distinct stable value for each node on the same virtual bus:
# NMEA_UNIQUE_NUMBER=1
NMEA_DEVICE_INSTANCE=0
NMEA_SYSTEM_INSTANCE=0
NMEA_ENGINE_INSTANCE=0
# Receive-only dashboard transport; CLI arguments take precedence.
NMEA_TRANSPORT=socketcan
NMEA_GATEWAY_HOST=
NMEA_GATEWAY_PORT=29536
